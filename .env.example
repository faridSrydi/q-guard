# ==============================================================================
# Q-GUARD Production Environment Configuration
# Copy this file to .env on your VPS before running deploy.sh
# ==============================================================================

# Public Domain & SSL Notification Email
DOMAIN=q-guard.web.id
ACME_EMAIL=admin@q-guard.web.id

# Server Environment
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Database
DB_PATH=/app/data/qguard.db

# Authentication (IMPORTANT: Replace with strong random 64-char strings)
JWT_SECRET=qguard_jwt_super_secret_production_key_change_this_2026
JWT_EXPIRY=24h
API_KEY=qguard_esp32_device_telemetry_secure_key_2026

# Allowed CORS Origins (Comma-separated for multiple domains)
CORS_ORIGIN=https://q-guard.web.id,https://www.q-guard.web.id

# Logging Level (error, warn, info, debug)
LOG_LEVEL=info
