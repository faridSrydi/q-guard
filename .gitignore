# ==============================================================================
# Q-GUARD .gitignore
# ==============================================================================

# Node.js Dependencies
node_modules/
*/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment & Secrets (NEVER commit secrets!)
.env
*.env
!.env.example
!.env.*.example

# Local SQLite Database & Storage
backend/data/*.db
backend/data/*.db-wal
backend/data/*.db-shm
backend/data/*.sqlite
backend/data/backup_*.db
!backend/data/.gitkeep

# Logs
logs/
backend/logs/*
!backend/logs/.gitkeep
*.log

# Build Outputs & Bundles
dist/
dashboard/dist/
dashboard/.vite/
build/
.output/

# Caddy SSL & Cache Volumes (if created locally)
caddy_data/
caddy_config/
caddy_logs/

# IDE & Editor Files
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/

# Operating System Files
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# PlatformIO / Microcontroller Build Artifacts
.pio/
.pioenvs/
.piolibdeps/

# Temporary / Scratch Files
tmp/
temp/
scratch/
