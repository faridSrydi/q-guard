# Q-GUARD Backend Environment Configuration
# Copy this file to .env and fill in the values

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Database
DB_PATH=./data/qguard.db

# Authentication
JWT_SECRET=change-this-to-a-strong-random-secret-in-production
JWT_EXPIRY=24h
API_KEY=qguard-dev-api-key-change-in-production

# CORS
CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=info
